---
/**
 * Props:
 * rows: Array<{
 *   title: string,
 *   publications: Array<{ title: string, authors?: string, year?: string, href?: string }>,
 *   moreHref?: string
 * }>
 */
const { rows = [] } = Astro.props;
---

<section class="max-w-6xl mx-auto">
  {rows.map((row) => (
    <div class="mb-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-slate-900">{row.title}</h2>
        {row.moreHref && (
          <a href={row.moreHref} class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-full text-sm font-semibold hover:opacity-95">More publications</a>
        )}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {row.publications.map((pub) => (
          <article class="p-4 border border-slate-100 rounded-lg hover:shadow-sm transition">
            {pub.href ? (
              <a href={pub.href} target="_blank" rel="noopener noreferrer" class="no-underline">
                <h3 class="font-semibold text-slate-900">{pub.title}</h3>
                <p class="text-sm text-slate-600 mt-1">{pub.authors}{pub.year ? ` · ${pub.year}` : ''}</p>
              </a>
            ) : (
              <>
                <h3 class="font-semibold text-slate-900">{pub.title}</h3>
                <p class="text-sm text-slate-600 mt-1">{pub.authors}{pub.year ? ` · ${pub.year}` : ''}</p>
              </>
            )}
          </article>
        ))}
      </div>
    </div>
  ))}
</section>